# Server settings. Copy to .env.local for local development and fill in what you need.
# With GEMINI_API_KEY empty the app runs on the rules path and says so.
GEMINI_API_KEY=
# Comma separated model order, tried in turn on quota, overload or a missing model. Empty uses the built in order.
GEMINI_MODEL=
# Most HTTP calls to the model a server instance makes in 24 hours, retries and tool rounds included. 0 turns the model off. Default 200.
MODEL_DAILY_CALL_CAP=
# Requests per minute one client may make to any route. Default 60, at least 1.
API_RATE_LIMIT_PER_MINUTE=
# Model tasks per minute one client may start. Over it the rules path answers. 0 turns the model off. Default 6.
MODEL_RATE_LIMIT_PER_MINUTE=
# Key for the data.gov.in copy of the CPCB station data, used where the CPCB feed cannot be reached.
DATA_GOV_IN_API_KEY=
# on or off. off skips the direct CPCB feed, which does not answer from hosted servers, so a cold start never waits for it. Default on.
CPCB_DIRECT_FEED=
